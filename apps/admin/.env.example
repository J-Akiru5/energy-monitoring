# Shared secret for relay actuation. Must be set to the same value in both
# apps' Vercel project settings. The admin proxy attaches this server-side
# when forwarding relay commands to the web app.
RELAY_ADMIN_SECRET=

# URL of the web app's relay API endpoint (used by the admin proxy).
# Defaults to https://energy-monitoring-web.vercel.app/api/relay if unset.
# WEB_RELAY_URL=https://energy-monitoring-web.vercel.app/api/relay
