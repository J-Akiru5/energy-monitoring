/*
 * Firmware secrets template.
 *
 * Copy this file to `firmware/src/secrets.h` and fill in real values.
 * `secrets.h` is gitignored and must NEVER be committed — the repo is public.
 *
 * DEVICE_ID stays in main.ino (it is not sensitive).
 */
#ifndef SECRETS_H
#define SECRETS_H

// Wi-Fi credentials
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Device authentication token (must match the device's token used by the ingest API)
#define DEVICE_TOKEN  "your-device-token"

// Supabase Realtime (WebSocket) credentials for relay control
#define SUPABASE_HOST     "your-project.supabase.co"
#define SUPABASE_ANON_KEY "your-anon-key"

#endif // SECRETS_H
